# Google Cloud & Gemini Enterprise Agent Platform (GEAP) Configuration
export GOOGLE_GENAI_USE_VERTEXAI="true"
export GOOGLE_CLOUD_PROJECT_ID="your-google-cloud-project-id"
export GOOGLE_CLOUD_LOCATION="us-central1"
export GOOGLE_GENAI_LOCATION="global"
export GOOGLE_GENAI_MODEL="gemini-3.7-flash"
export BIGQUERY_LOCATION="US"

# Prevent google.auth.exceptions.MutualTLSChannelError by disabling mTLS auto-discovery:
export GOOGLE_API_USE_CLIENT_CERTIFICATE="false"
export GOOGLE_API_USE_MTLS_ENDPOINT="never"

# Optional:
# export LOG_LEVEL="INFO"   # adds the per-event A2A author lines; defaults to WARNING
# export BIGQUERY_MCP_COMMAND="$PWD/agents/sched_agent/scripts/mock-bigquery-mcp"
# export STRATEGY_DOCS_BUCKET="your-google-cloud-project-id-strategy-docs"

# Set at deploy time via `agents-cli deploy --update-env-vars`, not here.
# README Step 1 resolves them. Listed for reference:
#   STRATEGY_AGENT_ENGINE_ID / SCHEDULING_AGENT_ENGINE_ID  Agent Runtime Reasoning Engine unique IDs
#   STRATEGY_AGENT_URL / SCHEDULING_AGENT_URL              direct peer agent cards / endpoints
#   APP_URL                                                Cloud Run only; without it the card says localhost
#   GOOGLE_CLOUD_AGENT_ENGINE_ID / _LOCATION               this agent's sessions + Memory Bank.
#                                                          Injected on Agent Runtime. Give each agent its own.
